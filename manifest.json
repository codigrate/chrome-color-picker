{
  "manifest_version": 3,
  "name": "Color Picker",
  "description": "Eyedrop any color on screen and read it in every color space, with contrast checks, harmonies and more. By Codigrate.",
  "version": "2026.1.3",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Color Picker",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ]
}
